# VoyagerAI Environment Variables
# Copy this file to .env.local and fill in your keys

# ── AI (Required for AI Advisor + Trip Planner) ──
# Get your key from https://console.anthropic.com
VITE_CLAUDE_API_KEY=your_anthropic_api_key_here

# ── Weather (Optional — free tier) ──
# Get from https://openweathermap.org/api
VITE_OPENWEATHER_KEY=your_openweathermap_api_key_here

# ── Google APIs (Optional — for Translator image mode) ──
# Enable Cloud Translation API v2 at https://console.cloud.google.com
VITE_GOOGLE_TRANSLATE_KEY=your_google_translate_key_here
